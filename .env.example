# ============================================================
# NEXUS — Environment Configuration Example
# Copy this to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev_password@localhost:5432/nexus

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# ── Reranking ─────────────────────────────────────────────────
# Options: "cross_encoder" | "cohere" | "none"
RERANKER_TYPE=cross_encoder
# COHERE_API_KEY=...  (only needed if RERANKER_TYPE=cohere)

# ── Ingestion ─────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ── Retrieval ─────────────────────────────────────────────────
VECTOR_SEARCH_LIMIT=20
FULL_TEXT_SEARCH_LIMIT=20
RERANKER_TOP_K=5

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_QUERY_TRACES=true
